# wombat environment — copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Keys/secrets live ONLY here (in your local .env), never in committed source.
# The Python app (pydantic-settings) and the Node memory pipeline both load the repo-root .env.

# --- Model egress (wombat core, required to run the composition root) ----------------------
# The DeepSeek-compatible endpoint the "mouth" speaks through (S4). Required by load_config().
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# --- wombat Postgres tests (optional) ------------------------------------------------------
# Enables the DSN-gated durable-store tests (TK-2 queue, TK-29 pending journal, TK-152 ledger).
# Absent -> those tests pytest.skip (CI stays zero-infra). Point at a throwaway Postgres, e.g.:
#   docker run --rm -d -p 5433:5432 -e POSTGRES_PASSWORD=wombat postgres:16
WOMBAT_TEST_PG_DSN=

# --- Agent-memory pipeline (memory/, Node) -------------------------------------------------
# The local memory DB password (memory/docker-compose.yml). Secret -> env only.
# Local dev default is `wombat-memory-local`; it is baked into the existing DB volume, so keep
# this value unless you recreate the volume.
WOMBAT_MEMORY_PG_PASSWORD=
# Non-secret connection overrides (defaults shown; uncomment only to change):
# WOMBAT_MEMORY_PG_HOST=localhost
# WOMBAT_MEMORY_PG_PORT=5544
# WOMBAT_MEMORY_PG_USER=wombat
# WOMBAT_MEMORY_PG_DATABASE=wombat_memory
# Embedding backend (Ollama) — non-secret; override only if not on the default local endpoint:
# WOMBAT_MEMORY_OLLAMA_URL=http://localhost:11434
# WOMBAT_MEMORY_EMBED_MODEL=nomic-embed-text

# --- Voice/persona config surface (TK-187, optional; default fully offline/local) ----------
# Provider selection is a structural opt-in only (DEC-28) — TK-193 wires actual clients, TK-188
# resolves keys from the keyring. Closed vocabulary enforced at boot: local|deepgram|elevenlabs|fish.
# WOMBAT_STT_PROVIDER=local
# WOMBAT_TTS_PROVIDER=local
# WOMBAT_TTS_VOICE_ID=
# WOMBAT_STT_MODEL=
# WOMBAT_ELEVENLABS_API_KEY=
# WOMBAT_DEEPGRAM_API_KEY=
# WOMBAT_FISH_API_KEY=
# WOMBAT_ASSISTANT_NAME=Steward

# --- Persona matrix config surface (TK-208, optional; default = today's steward exactly) ---
# Five closed axes (DEC-33/DEC-37); nothing reads these yet (TK-209 owns hot-apply).
# WOMBAT_PERSONA_BREVITY=terse           # terse|balanced|expansive
# WOMBAT_PERSONA_WARMTH=reserved         # reserved|neutral|warm
# WOMBAT_PERSONA_DIRECTNESS=plain        # gentle|plain|blunt
# WOMBAT_PERSONA_HUMOR=none              # none|dry
# WOMBAT_PERSONA_PROACTIVITY=balanced    # minimal|balanced|forward

# --- Timezone (TK-228, DEC-40; optional, default = this host's own local zone) -------------
# The canonical IANA zone every wombat tz consumer (the morning brief timer, the daily/dream
# civil-day boundary, etc.) resolves against. Unset -> the host's own zone, resolved via tzlocal
# (never a silent UTC fallback). Set only to OVERRIDE the host default, e.g. a server whose OS
# zone isn't the operator's zone. NOT app-editable (operator .env tier only).
# WOMBAT_TIMEZONE=America/New_York

# --- wombat durable substrate — real-adapter path (only when wired; not used by cold-boot) --
# wombat's own Postgres (queue + pending-journal + ledgers) and the cog-worx graph store.
# Leave blank for the v1 zero-infra cold-boot default.
# WOMBAT_PG_DSN=
# NEO4J_URI=
# NEO4J_USER=
# NEO4J_PASSWORD=
