# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
**/.venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# App-editable settings file (TK-196) — non-secret, machine-local, never committed.
wombat.settings.json
wombat.settings.json.migrated

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# TK-238: wombat-console.ps1's default runtime log directory (timestamped
# console logs) - local-only, never committed.
logs/

# Node (memory pipeline)
node_modules/

# Agent-memory local state (per-session byte cursors)
.claude/memory/
planning/.state.json

# Throwaway real-data spike fixtures (DEC-24): real Gmail/Calendar pulled
# locally via MCP for RISK-1/2/6 spikes (TK-22/26/73). Local-only, never
# committed — NG-7 storage-residency enforcement (local read, no egress).
**/fixtures/*.real.*
tests/**/fixtures/*.real.*

# app/ (TK-198): the Electron shell's own toolchain/build output. app/ source
# (incl. app/package-lock.json) IS committed; deps and build artifacts are not.
app/node_modules/
app/dist/
app/dist-electron/
app/out/
# TK-201: Playwright-for-Electron smoke run artifacts (failure traces/report) - never committed.
app/test-results/
app/playwright-report/
