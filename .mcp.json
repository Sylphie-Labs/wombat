{
  "mcpServers": {
    "codebase-pkg": {
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "@sylphie-labs/codebase-pkg",
        "codebase-pkg-mcp"
      ],
      "env": {}
    },
    "mempalace": {
      "command": "npx",
      "args": [
        "-y",
        "mempalace",
        "mcp"
      ],
      "env": {}
    }
  }
}
